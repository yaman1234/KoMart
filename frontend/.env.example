# FastAPI backend (Vite dev server proxies /api → http://localhost:8000)
VITE_API_BASE_URL=/api/v1

# Set to true only for offline UI development without a backend
VITE_USE_MOCK=false

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# Unsigned preset for PO bill images (folder is configured on the preset in Cloudinary)
VITE_CLOUDINARY_UPLOAD_PRESET_PURCHASEORDER=your_po_bill_unsigned_preset
